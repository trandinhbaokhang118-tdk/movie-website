# TMDB metadata/trailer import. Use either the v4 bearer token or v3 API key.
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=

# Public Supabase Data API configuration. Never put a secret/service-role key here.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Comma-separated bootstrap administrators. Authorization is always checked server-side.
ADMIN_EMAILS=

# Cloudflare Turnstile. Use dashboard keys in production; localhost uses official Cloudflare test keys by default.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=
# Chỉ dùng khi tự chạy localhost; production luôn để 0.
CINEWAVE_LOCAL_AUTH=0

# VietQR beneficiary and SePay webhook authentication.
PAYMENT_BANK_CODE=
PAYMENT_BANK_ACCOUNT=
PAYMENT_ACCOUNT_NAME=
SEPAY_WEBHOOK_API_KEY=
